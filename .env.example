# Copy this file to ".env" and fill in real values before running the project.
# NEVER commit the real ".env" file to git / GitHub.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Change to your real domain when you go live, e.g:
# ALLOWED_HOSTS=xbgremove.com,www.xbgremove.com

# CSRF trusted origins (needed once you deploy with HTTPS), comma separated:
CSRF_TRUSTED_ORIGINS=

# Site info (used in templates / SEO tags / Google Ads verification)
SITE_NAME=Xbg Remove
SITE_DOMAIN=http://127.0.0.1:8000

# Google Analytics / Google AdSense (leave blank until your Ads/Analytics
# account is approved, then paste the IDs here - no code changes needed)
GOOGLE_ANALYTICS_ID=
GOOGLE_ADSENSE_CLIENT_ID=

# Upload limits
MAX_UPLOAD_SIZE_MB=10
