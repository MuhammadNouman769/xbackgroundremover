# Copy this file to .env and replace the placeholders with real production values
SECRET_KEY=replace-with-a-long-random-production-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_NAME=Xbg Remove
SITE_DOMAIN=https://yourdomain.com
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXX
MAX_UPLOAD_SIZE_MB=10
REMBG_MODEL=u2netp

# Optional production email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Keep this file private and never commit the real .env to git.
